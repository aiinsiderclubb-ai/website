# ─── Google Analytics 4 ───────────────────────────────────────
# Get your Measurement ID from: https://analytics.google.com
# Settings → Data Streams → your stream → Measurement ID (starts with G-)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Newsletter (optional) ────────────────────────────────────
# ConvertKit Form ID (if using ConvertKit)
# NEXT_PUBLIC_CONVERTKIT_FORM_ID=1234567
# Mailchimp subscribe URL (if using Mailchimp)
# NEXT_PUBLIC_MAILCHIMP_URL=https://yourlist.us1.list-manage.com/subscribe/post?u=...

# ─── Telegram stats API (optional) ─────────────────────────────
# Used by /api/telegram/stats to show one live community member count.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=@your_channel_or_group
